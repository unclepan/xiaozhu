# ─────────────────────────────────────────────────────────────
# .env.example —— 复制为本地 .env 后填入真实值，严禁填入后提交本文件
# ─────────────────────────────────────────────────────────────

# 数据库连接串（MySQL @ 腾讯云 CynosDB）
#   <PASSWORD> 替换为真实密码
#   <DB_NAME>  替换为目标数据库名（需先在实例中创建）
DATABASE_URL="mysql://user:<PASSWORD>@gz-cynosdbmysql-grp-fgzke7rt.sql.tencentcdb.com:20231/<DB_NAME>?connection_limit=5"

# 简易管理端（/admin）口令
#   在 /admin 输入框里填这个值即可通过校验，通过后写入 7 天有效的 httpOnly cookie
#   留空 = 关闭 /admin（一律拒绝访问，fail-closed）
#   生成：openssl rand -hex 24
ADMIN_SESSION_TOKEN="<ADMIN_SESSION_TOKEN>"

# ===== 邮件（SMTP）—— 券码邮件 /api/deal/order/email =====
#   留空 = 关闭发送能力（接口返回 503，前端提示未配置，不影响下单）
#   QQ 邮箱：SMTP_HOST=smtp.qq.com / SMTP_PORT=587 / SMTP_PASS=授权码（非登录密码）
#   465 端口走隐式 TLS；587 / 25 走 STARTTLS（自动升级）
SMTP_HOST="<SMTP_HOST>"
SMTP_PORT="587"
SMTP_USER="<SMTP_USER>"
SMTP_PASS="<SMTP_PASS>"
# 可选：发件人展示地址，缺省回落到 SMTP_USER
MAIL_FROM="<MAIL_FROM>"
